{
  "camera": {
    "left": 0,
    "right": 1,
    "width": 1280,
    "height": 720,
    "fps": 30,
    "backend": "auto",
    "fourcc": "MJPG",
    "buffer_size": 1,
    "alternate_grab_order": true,
    "selection": {
      "startup_pick": true,
      "probe_max_index": 7,
      "first_frame_attempts": 5
    }
  },
  "pose": {
    "model": "yolo11n-pose.pt",
    "device": "auto",
    "detection_confidence": 0.35,
    "keypoint_confidence": 0.45
  },
  "stereo": {
    "calibration_dir": "runtime/calibrations",
    "load": "latest",
    "explicit_file": null,
    "board_cols": 9,
    "board_rows": 6,
    "square_mm": 25
  },
  "calibration_runtime": {
    "session_dir": "runtime/sessions",
    "auto_capture": true,
    "auto_capture_interval_s": 0.7,
    "min_pairs_to_solve": 12,
    "target_pairs": 24,
    "recommended_readiness": 75,
    "min_board_area_ratio": 0.012,
    "diversity_threshold": 0.12,
    "stable_dwell_s": 0.3,
    "stable_min_frames": 3,
    "stable_corner_motion_px": 5,
    "stable_loss_grace_s": 1.25,
    "robust_prune": true,
    "prune_min_epipolar_px": 0.8,
    "prune_max_epipolar_px": 2.5,
    "max_prune_fraction": 0.25,
    "keep_images_after_success": false
  },
  "quality": {
    "max_epipolar_error_px": 3,
    "max_reprojection_error_px": 2.5,
    "min_depth_mm": 250,
    "max_depth_mm": 7000,
    "min_quality_score": 0.12,
    "max_joint_speed_mm_s": 6000,
    "speed_gate_reset_after_s": 0.6
  },
  "smoothing": {
    "enabled": true,
    "type": "one_euro",
    "min_cutoff": 1.2,
    "beta": 0.015,
    "d_cutoff": 1,
    "reset_after_s": 0.6
  },
  "cleanup": {
    "enabled": true,
    "keep_latest_calibrations": 10,
    "delete_failed_sessions_older_days": 7
  },
  "output": {
    "joint_group": "ergonomics",
    "joints": [],
    "console": true,
    "console_every_n_frames": 5,
    "jsonl_file": null,
    "udp": {
      "enabled": false,
      "host": "127.0.0.1",
      "port": 5005
    }
  },
  "diagnostics": {
    "enabled": false,
    "every_n_frames": 10
  },
  "runtime": {
    "root": "runtime",
    "show_preview": true,
    "log_dir": "runtime/logs"
  },
  "readout": {
    "joint_group": "upper",
    "joints": []
  },
  "world": {
    "dictionary": "DICT_4X4_50",
    "reference_file": "runtime/world/reference_points.csv",
    "coordinate_name": "WORLD",
    "max_residual_mm": 10
  },
  "recording": {
    "enabled": true,
    "auto_start": false,
    "sample_rate_hz": 5,
    "save_csv": true,
    "output_dir": "runtime/recordings",
    "include_rejected_candidates": true
  }
}
