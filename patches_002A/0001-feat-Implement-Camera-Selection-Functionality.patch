+        self.assertEqual(s.handle_key(_k("r")), "rescan")
+        self.assertEqual(s.handle_key(_k("q")), "cancel")
+        s2 = self.make()
+        self.assertEqual(s2.handle_key(KEY_ESC), "cancel")
