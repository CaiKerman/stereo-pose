+    def test_no_key_and_unknown_keys_ignored(self):
+        s = self.make()
+        self.assertIsNone(s.handle_key(255))
+        self.assertIsNone(s.handle_key(_k("z")))
+        self.assertEqual((s.left, s.right), (None, None))
